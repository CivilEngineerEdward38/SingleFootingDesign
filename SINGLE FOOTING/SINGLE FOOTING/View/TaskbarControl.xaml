<UserControl x:Class="Autocad_API.Mongdon.View.TaskBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Autocad_API.Mongdon.View"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="700" Background="Honeydew">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../MyResource/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="False" Background="Beige">
        <Button Style="{StaticResource ButtonStyle }" Width="65" DockPanel.Dock="Left">
            <Image Source="../Img/information-284-32.png"/>
        </Button>
        <Button DockPanel.Dock="Right" Width="40" Style="{StaticResource ButtonStyle}" Background="White">
            <Image Source="../Img/close-37-32.png"/>
        </Button>
        <ComboBox DockPanel.Dock="Right" Width="60" Style="{StaticResource ComboBoxStyle}">
        </ComboBox>
        <TextBlock DockPanel.Dock="Right" Text="Chọn ngôn ngữ" Style="{StaticResource DataGridTextBlockStyle}"/>
    </DockPanel>
</UserControl>
