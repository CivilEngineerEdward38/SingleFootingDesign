<UserControl x:Class="ACAD_API.SINGLE_FOOTING.View.TaskbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ACAD_API.SINGLE_FOOTING.View"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="700" Background="Honeydew"
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../MyResource/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="False" Background="Beige">
        <i:Interaction.Triggers>
            <i:EventTrigger EventName="MouseLeftButtonDown">
                <i:InvokeCommandAction Command="{Binding MouseLeftButtonDownCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </i:EventTrigger>
        </i:Interaction.Triggers>
        <Button Style="{StaticResource ButtonStyle }" Width="32" DockPanel.Dock="Left" Command="{Binding GotoWebCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
            <Image Source="../Img/information-284-32.png"/>
        </Button>
        <Button DockPanel.Dock="Right" Width="40" Style="{StaticResource ButtonStyle}" Background="White" Command="{Binding ClosedWindowCommand}" CommandParameter="{Binding ElementName=MainWindow}">
            <Image Source="../Img/close-37-32.png"/>
        </Button>
        <ComboBox DockPanel.Dock="Right" Width="60" Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding DataContext.LanguageModel.AllLanguages,RelativeSource={RelativeSource AncestorType=Window}}"
       SelectedItem="{Binding DataContext.LanguageModel.SelectedLanguage,RelativeSource={RelativeSource AncestorType=Window},UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
               >

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding DataContext.SelectionLanguageChangedCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>

        </ComboBox>
        <TextBlock DockPanel.Dock="Right" Text="Chọn ngôn ngữ" Style="{StaticResource DataGridTextBlockStyle}"/>
    </DockPanel>
</UserControl>
