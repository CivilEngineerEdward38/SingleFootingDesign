<Window x:Class="ACAD_API.SLAB_BEAM_RAFT_FOOTING.View.MongBanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ACAD_API.SLAB_BEAM_RAFT_FOOTING.View"
        mc:Ignorable="d"
        Title="MongBanWindow" Height="850"
        Width="920"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontSize="11"
        FontFamily="Tohoma"
        WindowStyle="None"
        AllowsTransparency="True"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        x:Name="MainWindow"
        xmlns:view="clr-namespace:ACAD_API.SLAB_BEAM_RAFT_FOOTING.View"
        xmlns:viewModel="clr-namespace:ACAD_API.SLAB_BEAM_RAFT_FOOTING.ViewModel"
    
        >
    <Window.Resources>
        <ResourceDictionary>
            <!-- 1. Chỉ nhúng file bên ngoài qua Source -->
            <ResourceDictionary.MergedDictionaries>
            <!-- Dùng Pack URI tuyệt đối thay cho đường dẫn tương đối ../ -->
                <ResourceDictionary Source="../../Style/Styles.xaml"/>
        </ResourceDictionary.MergedDictionaries>

            <!-- 2. Khai báo DataTemplate bên ngoài MergedDictionaries -->
            <DataTemplate DataType="{x:Type viewModel:TaskBarControlViewModel}">
                <view:TaskBarViewMongBan />
            </DataTemplate>
            <!--<cvt:StringContentToColor x:Key="StringContentToColor" />-->
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <!--Khai báo grid local-->
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="760" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <!--Khai báo grid local-->
        <GroupBox Grid.Row="1"
           Header="Input"
           BorderBrush="#00008b"
           Margin="3 0 0 0">
            <Grid>
                <!--khai báo 4 lưới nhập liệu-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225" />
                    <ColumnDefinition Width="225" />
                    <ColumnDefinition Width="225" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <!--Cột 1-->
                <GroupBox Grid.Column="0" Header="Bản móng" BorderBrush="#00008b" Margin="3 0 0 0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <!--#region Chiều rộng bản-->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Chiều rộng bản"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.ChieuRongMong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Chiều dài bản-->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Chiều dài bản"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.ChieuDaiMong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Chiều cao bản -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Chiêu cao bản"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.ChieuCaoBan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Chiều Rộng đục lỗ-->
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Đục lỗ"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.DucLoMong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <Rectangle Grid.Row="4"
                                   Height="1"
                                   Fill="#00008b"
                                   VerticalAlignment="Top"
                                   Margin="0 -1 0 0"
                                   HorizontalAlignment="Stretch"
                                   Grid.ColumnSpan="3" />
                        <TextBlock Grid.Row="4"
                                   Grid.ColumnSpan="3"
                                   Margin="0 5 0 0"
                                   Text="Ô bản 2 cạnh" />
                        <!--#region Đường kính ô bản 2 cạnh-->
                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Text="ĐK Thép "
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <ComboBox Grid.Row="5"
                                  Grid.Column="1"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Height="24"
                                  ItemsSource="{Binding MongBanModel.LayoutMongBanModel.AllDuongKinh}"
                                  SelectedItem="{Binding ThongSoMongBan.DKThep_Oban_1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="5"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Khoảng cách ô bản 2 cạnh-->
                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   Text="KC thép"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="6"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.KCThep_Oban_1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="6"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Cắt thép ô bản 2 cạnh-->
                        <CheckBox Grid.Row="7"
                                  Grid.Column="0"
                                  Content="Cắt thép"
                                  Style="{StaticResource CheckBoxStyle}"
                                  IsChecked="{Binding HaveCutThep_Oban1}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding HaveCutThepOban1Command}"
                                                           CommandParameter="{Binding ElementName=MainWindow}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </CheckBox>
                        <!--#endregion-->
                        <Rectangle Grid.Row="8"
                                   Height="1"
                                   Fill="#00008b"
                                   VerticalAlignment="Top"
                                   Margin="0 -1 0 0"
                                   HorizontalAlignment="Stretch"
                                   Grid.ColumnSpan="3" />
                        <TextBlock Grid.Row="8"
                                   Grid.ColumnSpan="3"
                                   Margin="0 5 0 0"
                                   Text="Ô bản 3 cạnh" />
                        <!--#region Đường kính ô bản 3 cạnh-->
                        <TextBlock Grid.Row="9"
                                   Grid.Column="0"
                                   Text="ĐK Thép "
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <ComboBox Grid.Row="9"
                                  Grid.Column="1"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Height="24"
                                  ItemsSource="{Binding MongBanModel.LayoutMongBanModel.AllDuongKinh}"
                                  SelectedItem="{Binding ThongSoMongBan.DKThep_Oban_2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="9"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Khoảng cách ô bản 3 cạnh-->
                        <TextBlock Grid.Row="10"
                                   Grid.Column="0"
                                   Text="KC Thép"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="10"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.KCThep_Oban_2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="10"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Cắt thép ô bản 3 cạnh-->
                        <CheckBox Grid.Row="11"
                                  Grid.Column="0"
                                  Content="Cắt thép"
                                  IsChecked="{Binding HaveCutThep_Oban2}"
                                  Style="{StaticResource CheckBoxStyle}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding HaveCutThepOban2Command}"
                                   CommandParameter="{Binding ElementName=MainWindow}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </CheckBox>
                        <!--#endregion-->
                        <Rectangle Grid.Row="12"
                                   Height="1"
                                   Fill="#00008b"
                                   VerticalAlignment="Top"
                                   Margin="0 -1 0 0"
                                   HorizontalAlignment="Stretch"
                                   Grid.ColumnSpan="3" />
                        <TextBlock Grid.Row="12"
                                   Grid.ColumnSpan="3"
                                   Margin="0 5 0 0"
                                   Text="Thanh thép chống" />
                        <!--#region Loại thép chống-->
                        <TextBlock Grid.Row="13"
                                   Grid.Column="0"
                                   Text="Loại chống "
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <ComboBox Grid.Row="13"
                                  Grid.Column="1"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Height="24"
                                  ItemsSource="{Binding LayoutMongBanModel.ListThanhThepChong}"
                                  SelectedItem="{Binding LayoutMongBanModel.SelectedLoaiChong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="13"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Đường kính thép chống-->
                        <TextBlock Grid.Row="14"
                                   Grid.Column="0"
                                   Text="ĐK Thép "
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <ComboBox Grid.Row="14"
                                  Grid.Column="1"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Height="24"
                                  ItemsSource="{Binding MongBanModel.LayoutMongBanModel.AllDuongKinh}"
                                  SelectedItem="{Binding ThongSoMongBan.DKThepChong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="14"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Khoảng cách ô bản 2 cạnh-->
                        <TextBlock Grid.Row="15"
                                   Grid.Column="0"
                                   Text="KC Thép Ô bản 1"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="15"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.KCThepChong_Oban1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="15"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Khoảng cách ô bản 2 cạnh-->
                        <TextBlock Grid.Row="16"
                                   Grid.Column="0"
                                   Text="KC Thép Ô bản 2"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="16"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.KCThepChong_Oban2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="16"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <Rectangle Grid.Row="17"
                                   Height="1"
                                   Fill="#00008b"
                                   VerticalAlignment="Top"
                                   Margin="0 -1 0 0"
                                   HorizontalAlignment="Stretch"
                                   Grid.ColumnSpan="3" />
                        <CheckBox Grid.Row="17"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="3"
                                  Content="Đối trọng ?"
                                  Margin="0 5 0 0"
                                  Style="{StaticResource CheckBoxStyle}"
                                  IsChecked="{Binding HaveDoiTrong}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding HaveDoiTrongCommand}"
                                                           CommandParameter="{Binding ElementName=MainWindow}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </CheckBox>
                        <!--#region Chiều dày đối trọng -->
                        <TextBlock Grid.Row="18"
                                   Grid.Column="0"
                                   Text="Chiều cao ĐT"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="18"
                                 Grid.Column="1"
                                 IsEnabled="{Binding IsEnableDoiTrong}"
                                 Text="{Binding ThongSoMongBan.ChieuCaoDoiTrong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="18"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <Rectangle Grid.Row="19"
                                   Height="1"
                                   Fill="#00008b"
                                   VerticalAlignment="Top"
                                   Margin="0 -1 0 0"
                                   HorizontalAlignment="Stretch"
                                   Grid.ColumnSpan="3" />
                        <TextBlock Grid.Row="20"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Text="Đệm cát"
                                   Margin="0 5 0 0"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#region Chiều dày đệm cát -->
                        <TextBlock Grid.Row="21"
                                   Grid.Column="0"
                                   Text="Chiều dày ĐC"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="21"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.H_DemCat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="21"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Độ dốc mở mái -->
                        <TextBlock Grid.Row="22"
                                   Grid.Column="0"
                                   Text="Hệ số mái taluy"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="22"
                                 Grid.Column="1"
                                 Text="{Binding HeSoMai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="22"
                                   Grid.Column="2"
                                   Text=""
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Chiều cao đất đắp -->
                        <TextBlock Grid.Row="23"
                                   Grid.Column="0"
                                   Text="H đắp "
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="23"
                                 Grid.Column="1"
                                 Text="{Binding HDapMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="23"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                    </Grid>
                </GroupBox>
                <!--Cột 1-->
                <!--Cột 2-->
                <GroupBox Grid.Column="1"
                          BorderBrush="#00008b"
                          Margin="3 0 0 0"
                          Header="Cổ móng">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <!--#region Chiều sâu chôn móng -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Chiều sâu chôn"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.ChieuSauChonMong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Chiều cao cổ móng -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Chiều cao cổ"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.ChieuCaoCoMong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Chiều Rông cổ móng Bc -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Rộng cổ Bc"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.RongCoMong_Top, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Chiều Rông cổ móng Bot -->
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Rộng cổ B'c"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.RongCoMong_Bot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region KC mép dầm - cột  -->
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="KC mép dầm-cột"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Text="{Binding KC_Mep_DamCot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="4"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Lệch tâm cổ Bc nếu có  -->
                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Text="Lêch tâm cổ Top"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="5"
                                 Grid.Column="1"
                                 Text="{Binding LechTamCoTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="5"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <Rectangle Grid.Row="6"
                                   Height="1"
                                   Fill="#00008b"
                                   VerticalAlignment="Top"
                                   Margin="0 -1 0 0"
                                   HorizontalAlignment="Stretch"
                                   Grid.ColumnSpan="3" />
                        <!--#region Đường kính thép chủ cổ móng -->
                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   Text="ĐK Thép chủ"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <ComboBox Grid.Row="6"
                                  Grid.Column="1"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Height="24"
                                  ItemsSource="{Binding MongBanModel.LayoutMongBanModel.AllDuongKinh}"
                                  SelectedItem="{Binding ThongSoMongBan.DKThepChu_CM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="6"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Số lượng thép chủ cổ móng -->
                        <TextBlock Grid.Row="7"
                                   Grid.Column="0"
                                   Text="SL Thép chủ"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="7"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.SLThepChu_CM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="7"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Đường kính đai CM -->
                        <TextBlock Grid.Row="8"
                                   Grid.Column="0"
                                   Text="ĐK Thép đai"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <ComboBox Grid.Row="8"
                                  Grid.Column="1"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Height="24"
                                  ItemsSource="{Binding MongBanModel.LayoutMongBanModel.AllDuongKinh}"
                                  SelectedItem="{Binding ThongSoMongBan.DKThepDai_CM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="8"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Khoảng cách thép đai CM -->
                        <TextBlock Grid.Row="9"
                                   Grid.Column="0"
                                   Text="KC Thép đai"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <TextBox Grid.Row="9"
                                 Grid.Column="1"
                                 Text="{Binding ThongSoMongBan.KCThepDai_CM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Row="9"
                                   Grid.Column="2"
                                   Text="mm"
                                   Style="{StaticResource DataGridTextBlockStyle}" />
                        <!--#endregion-->
                        <!--#region Khoảng rải đai 100-->
                        <CheckBox  Grid.Row="10"
                                   Grid.Column="0"
                                   Content="Rải đai 100"
                                   IsChecked="{Binding HaveRai100}"
                                   Style="{StaticResource CheckBoxStyle}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding HaveRai100Command}"
                                                           CommandParameter="{Binding ElementName=MainWindow}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </CheckBox>
