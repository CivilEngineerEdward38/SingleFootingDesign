                         <TextBox Grid.Row="19"
                                  Grid.Column="1"
                                  Style="{StaticResource TextBoxStyle}"
                                  Text="{Binding TenMongLayOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                         <TextBlock Grid.Row="19"
                                    Grid.Column="2"
                                    Style="{StaticResource DataGridTextBlockStyle}"
                                    Text="" />-->
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
        <StackPanel Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Load Khung tên"
                    Style="{StaticResource ButtonStyle}"
                    Height="30"
                    Width="100"
                    Foreground="White"
                    Command="{Binding LoadKhungTenCommand}"
                    CommandParameter="{Binding ElementName=MainWindow}" />
            <Button Content="Load Data"
                    Style="{StaticResource ButtonStyle}"
                    Height="30"
                    Width="100"
                    Foreground="White"
                    Command="{Binding LoadDataCommand}"
                    CommandParameter="{Binding ElementName=MainWindow}" />
            <Button Content="Vẽ"
                    Style="{StaticResource ButtonStyle}"
                    Height="30"
                    Width="100"
                    Foreground="White"
                    Command="{Binding VeAcadCommand}"
                    CommandParameter="{Binding ElementName=MainWindow}" />
            <Button Content="Cancel"
                    Style="{StaticResource ButtonStyle}"
                    Height="30"
                    Width="100"
                    Foreground="White"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding ElementName=MainWindow}" />
        </StackPanel>
    </Grid>
</Window>
