                        <TextBlock Grid.Row="20"
                    Grid.Column="2"
                    Style="{StaticResource DataGridTextBlockStyle}"
                    Text="" />
                        <StackPanel Grid.Row="21"
                     Grid.Column="0"
                     Grid.ColumnSpan="3"
                     Orientation="Horizontal"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left">
                            <RadioButton Style="{StaticResource RadioButtonStyle}"
                          Content="Khung Ngang"
                          IsChecked="{Binding IsKhungNgang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click">
                                        <i:InvokeCommandAction Command="{Binding KhungA3NgangCommand}"
                                                CommandParameter="{Binding ElementName=MainWindow}">
                                        </i:InvokeCommandAction>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </RadioButton>
                            <RadioButton Style="{StaticResource RadioButtonStyle}"
                          Content="Khung Dọc"
                          IsChecked="{Binding IsKhungDoc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click">
                                        <i:InvokeCommandAction Command="{Binding KhungA3DocCommand}"
                                                CommandParameter="{Binding ElementName=MainWindow}">
                                        </i:InvokeCommandAction>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </RadioButton>
                        </StackPanel>
                        <!--#region Số bản vẽ-->
