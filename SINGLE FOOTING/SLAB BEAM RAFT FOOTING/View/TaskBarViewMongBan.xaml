<UserControl x:Class="ACAD_API.SLAB_BEAM_RAFT_FOOTING.View.TaskBarViewMongBan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ACAD_API.SLAB_BEAM_RAFT_FOOTING.View"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Style/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <DockPanel LastChildFill="False"
                   Background="White">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeftButtonDown">
                    <i:InvokeCommandAction Command="{Binding MouseLeftButtonDownCommand}"
                                           CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <Button DockPanel.Dock="Left"
                    Width="50"
                    Style="{StaticResource ButtonStyle}"
                    Background="White"
                    Command="{Binding GotoWebCommand}"
                    CommandParameter="{Binding ElementName=MainWindow}">
                <!--<Image Width="50"
                       Source="../../Img/logo.png"
                       Height="20" />-->
            </Button>

            <TextBlock Text="VẼ MÓNG BẢN "
                       Foreground="#184494"
                       FontWeight="Bold"
                       Margin="5 0 0 0" />

            <Button DockPanel.Dock="Right"
                    Width="40"
                    Style="{StaticResource ButtonStyle}"
                    Background="White"
                    Command="{Binding ClosedWindowCommand}"
                    CommandParameter="{Binding ElementName=MainWindow}">
                <Image Width="30"
                       Source="../../Img/delete.png"
                       Height="30" />
            </Button>


        </DockPanel>
    </Grid>
</UserControl>
